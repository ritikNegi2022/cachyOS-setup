#!/bin/sh
# Ly session script: dwm
# Referenced by configs/ly/dwm.desktop (Exec= line), installed to /etc/ly/dwm-session
# Runs when the user selects "dwm" at the ly login screen.

# Ensure npm global and local bin are in PATH for dwm-spawned helpers (super-clipboard, remind, etc.)
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.bin:/usr/local/bin:$PATH"

# Touchegg daemon — must run inside the user session for xdotool to work.
# Arch's packaged /etc/xdg/autostart/touchegg.desktop does this too; the
# pgrep guard avoids a second instance.
pgrep -x touchegg >/dev/null 2>&1 || { nohup touchegg >/tmp/touchegg.log 2>&1 & disown; }

# Pure black background — no wallpaper, no compositor needed
xsetroot -solid "#000000"

# Session key remaps: ESC<->CapsLock, Alt<->Ctrl (delete this line to revert)
# Run synchronously (no &) so remaps are applied before dwm grabs keys
if [ -x /etc/ly/keyswap.sh ]; then
    /etc/ly/keyswap.sh || xmodmap /etc/ly/keyswap.sh 2>/dev/null || true
fi
# Fallback: also try user Xmodmap if exists
[ -f "$HOME/.Xmodmap" ] && xmodmap "$HOME/.Xmodmap" 2>/dev/null || true

# Natural scrolling: apply live for current session (Xorg conf handles next boot)
while IFS= read -r _id; do
    xinput list-props "$_id" 2>/dev/null | grep -q "Natural Scrolling Enabled (" && \
        xinput set-prop "$_id" "libinput Natural Scrolling Enabled" 1 2>/dev/null || true
done < <(xinput list --id-only 2>/dev/null); unset _id

# Notifications (dunst — started once per session)
pgrep -x dunst >/dev/null 2>&1 || { nohup dunst >/tmp/dunst.log 2>&1 & disown; }

# Status bar (volume / brightness / battery / time → dwm's bar via xsetroot)
{ nohup /etc/ly/dwm-statusbar >/tmp/statusbar.log 2>&1 & disown; } || /etc/ly/dwm-statusbar &

# Reminder daemon: hourly time pings + user reminders (see `remind` CLI)
{ nohup /etc/ly/reminderd >/tmp/reminderd.log 2>&1 & disown; } || /etc/ly/reminderd &

# Super+Enter -> terminal: dwm does this natively (config.h: MODKEY+XK_Return -> termcmd).
# The pynput fallback (super-enter-live.py) is ONLY for old dwm binaries predating the rebuild.
# Detection must use a string actually embedded in the binary ("alacritty", same check as
# scripts/dwm-build.sh / scripts/doctor.sh). The old guard grepped for source text
# "MODKEY.*XK_Return.*termcmd", which never appears in `strings` output, so it was
# always true and spawned a 2nd terminal on every Super+Enter.
if strings "$(command -v dwm)" 2>/dev/null | grep -q "alacritty"; then
    # New dwm: native binding works — kill any stale fallback so Super+Enter opens exactly 1 window.
    pkill -f super-enter-live.py >/dev/null 2>&1 || true
else
    # Old/stock dwm: keep fallback until user rebuilds with scripts/dwm-build.sh.
    pgrep -f super-enter-live.py >/dev/null 2>&1 || nohup python3 "$HOME/.local/bin/super-enter-live.py" >/tmp/super-enter-live.log 2>&1 &
fi

# systemd user services (keypress-sound etc.): the session must import the
# environment (DISPLAY etc.) and start graphical-session.target for user
# units bound to it to launch. No-op-safe when run repeatedly.
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP 2>/dev/null || true
systemctl --user start graphical-session.target 2>/dev/null || true

# Boot autostart: exactly 1 alacritty on login. Preferred path is the systemd
# user service (configs/systemd/alacritty-autostart.service, enabled by
# scripts/bin-copy.sh) which starts via graphical-session.target above.
# Fallback `alacritty &` runs ONLY when that service is missing/disabled,
# guarded by pgrep so we never open 2 terminals at boot.
if systemctl --user is-enabled alacritty-autostart.service >/dev/null 2>&1; then
    : # systemd handles it — do nothing here
else
    pgrep -x alacritty >/dev/null 2>&1 || { nohup alacritty >/tmp/alacritty-autostart.log 2>&1 & disown; }
fi

# Start dwm (replaces this shell)
exec dwm
