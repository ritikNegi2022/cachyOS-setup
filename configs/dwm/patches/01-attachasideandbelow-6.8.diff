 void
+attachBelow(Client *c)
+{
+	if(c->mon->sel == NULL || c->mon->sel->isfloating) {
+		Client *at = nexttagged(c);
+		if(!at) {
+			attach(c);
+			return;
+		}
+		c->next = at->next;
+		at->next = c;
+		return;
+	}
+	c->next = c->mon->sel->next;
+	c->mon->sel->next = c;
+}
