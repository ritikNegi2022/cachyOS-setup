 void
+grid(Monitor *m) {
+	unsigned int n, cw, ch, cols, rows, r, k, nr, x, ypos;
+	Client *c;
+
+	for (n = 0, c = nexttiled(m->clients); c; c = nexttiled(c->next))
+		n++;
+	if (n == 0)
+		return;
+
+	/* grid dimensions: as square as possible, wider than tall */
+	for (cols = 0; cols * cols < n; cols++);
+	rows = (n + cols - 1) / cols;
+
+	/* row-major fill: leading rows take the extras, so every row is full
+	 * width and no screen area stays empty (e.g. 3 windows = 2 on top,
+	 * 1 full-width below) */
+	ypos = m->wy;
+	c = nexttiled(m->clients);
+	for (r = 0; r < rows && c; r++) {
+		nr = n / rows + (r < n % rows ? 1 : 0);
+		ch = (r == rows - 1) ? (m->wy + m->wh - ypos) : m->wh / rows;
+		for (k = 0; k < nr && c; k++, c = nexttiled(c->next)) {
+			cw = (k == nr - 1) ? (m->wx + m->ww - (m->wx + k * (m->ww / nr))) : m->ww / nr;
+			x = m->wx + k * (m->ww / nr);
+			resize(c, x, ypos, cw - 2 * c->bw, ch - 2 * c->bw, 0);
+		}
+		ypos += ch;
+	}
+}
