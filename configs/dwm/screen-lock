#!/bin/sh
# screen-lock — lock the X session WITHOUT closing apps (slock, black screen).
# Unlock with your normal login password. The dwm session keeps running
# underneath, so break-time locking never loses work.
#
# slock takes no arguments and shows no UI: screen goes BLACK while locked,
# flashes RED on a wrong password. (Black comes from our custom build,
# scripts/slock-build.sh — stock slock locks blue.)
#
# Used by:
#   - configs/acpi/power-btn.sh (power button -> lock, never poweroff)
#   - dwm lockcmd (Super+Shift+X, XF86 ScreenSaver -> lock)
#
# When run as root (acpid) it finds the graphical user and their
# DISPLAY/XAUTHORITY itself; when run as the user (dwm keybinding) the
# environment is already correct.
#
# Usage: screen-lock [--test]   (--test = dry run, locks nothing)
# Internal: screen-lock --child (already dropped to the session user)

LOG=/tmp/screen-lock.log
log() { echo "$(date '+%F %T') screen-lock: $*" >>"$LOG" 2>/dev/null; logger -t screen-lock "$*" 2>/dev/null || true; }

TEST=0
CHILD=0
[ "${1:-}" = "--test" ] && TEST=1
[ "${1:-}" = "--child" ] && CHILD=1

# Single instance: one power-button press often delivers duplicate ACPI
# events, and each would spawn its own slock — the top one steals the X grab,
# so you get a password prompt that flashes away and must type twice.
# The lock MUST be taken by the process that execs slock itself: an flock
# taken earlier (e.g. by the root wrapper) can be dropped when runuser/sudo
# launch the unprivileged child, reopening the race. So the root path below
# re-execs this script as the user (--child) and only that child locks.
#   1. flock: atomic, race-free for same-millisecond duplicates. fd 9 stays
#      open across the final plain `exec slock`, so it is held until unlock.
#   2. pgrep: backstop; a visible slock means a lock is already in progress.
GUARD=/tmp/screen-lock.guard
# exit code flock returns when the lock is already held (vs slock's own code)
CONFLICT=99

# Make sure the guard file exists and is shareable between the root/acpid
# path and the user/dwm-key path (first creator wins; each side repairs
# perms when it can). Pure redirections/commands — no `exec 9>` fd games:
# a failed redirection on exec kills a non-interactive shell outright.
ensure_guard() {
    ( umask 000; : >>"$GUARD" ) 2>/dev/null || true
    chmod 666 "$GUARD" 2>/dev/null || true
}

# guard_free: succeeds (0) if no lock is in progress and we may proceed.
# Uses `flock cmd` mode so the lock is held by flock itself until slock
# exits — nothing for runuser/sudo to drop, no fds to babysit in sh.
guard_free() {
    ensure_guard
    [ -w "$GUARD" ] || return 0  # unopenable (stale strict perms): degrade to pgrep-only
    flock -n -E "$CONFLICT" "$GUARD" true 2>/dev/null
    [ "$?" -ne "$CONFLICT" ]
}

take_guard() {
    if guard_free; then
        return 0
    fi
    log "lock already in progress — skipping duplicate request"
    [ "$TEST" = "1" ] && echo "TEST: lock in progress — would skip"
    exit 0
}

# lock_now: the atomic gate. Runs slock as a child of `flock`, so the
# lock is held until unlock — nothing to inherit, drop, or babysit.
# $1 = log label, e.g. "as blank on :0".
lock_now() {
    if command -v flock >/dev/null 2>&1 && [ -w "$GUARD" ]; then
        ensure_guard
        log "locking ($1)"
        flock -n -E "$CONFLICT" "$GUARD" slock
        rc=$?
        [ "$rc" -eq "$CONFLICT" ] && log "lock already in progress — skipping duplicate request"
        exit "$rc"
    fi
    # degraded: no flock binary or guard unopenable — pgrep-only backstop
    if [ "$TEST" != "1" ] && pgrep -x slock >/dev/null 2>&1; then
        log "slock already running — skipping duplicate request"
        exit 0
    fi
    log "locking ($1, unguarded)"
    exec slock
}

if ! command -v slock >/dev/null 2>&1; then
    log "slock MISSING — cannot lock (repo: sudo pacman -S --needed slock; black theme: bash scripts/slock-build.sh)"
    [ "$TEST" = "1" ] && echo "TEST: FAIL — slock not installed"
    command -v notify-send >/dev/null 2>&1 && notify-send -t 3000 'screen-lock' 'slock missing — install it' 2>/dev/null || true
    exit 1
fi

# Already the session user inside X (dwm keybinding, or --child after the
# root wrapper dropped privileges)? Take the guard here — in THIS process —
# and lock. The guard must live here so fd 9 survives the plain exec below.
if [ "$CHILD" = "1" ] || { [ "$(id -u 2>/dev/null)" != "0" ] && [ -n "${DISPLAY:-}" ]; }; then
    if [ "$TEST" = "1" ]; then
        take_guard  # exits 0 with "would skip" when held, else falls through
        echo "TEST: would run: slock (as ${USER:-$user} on ${DISPLAY:-$DISP})"
        exit 0
    fi
    lock_now "as ${USER:-$user} on ${DISPLAY:-$DISP}"
fi

# --- Running as root (acpid): find the graphical user + X creds ---------------
user="$(ps -o user= -C dwm 2>/dev/null | head -1 | tr -d ' ')"
if [ -z "$user" ] && command -v loginctl >/dev/null 2>&1; then
    sess="$(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 != "" {print $1}' | head -1)"
    [ -n "$sess" ] && user="$(loginctl show-session "$sess" -p Name --value 2>/dev/null)"
fi
if [ -z "$user" ] || [ "$user" = "root" ]; then
    u2="$(who 2>/dev/null | awk '{print $1}' | head -1)"
    [ -n "$u2" ] && [ "$u2" != "root" ] && user="$u2"
fi

if [ -z "$user" ] || [ "$user" = "root" ]; then
    # Nobody logged in graphically: ly greeter is already showing. Do nothing
    # (and crucially, never power off — logind is set to ignore the key).
    log "no graphical user — ly already showing, doing nothing"
    [ "$TEST" = "1" ] && echo "TEST: no graphical session (ly already showing) — would do nothing"
    exit 0
fi

DISP=""
XAUTH=""
dwm_pid="$(pgrep -u "$user" -x dwm 2>/dev/null | head -1)"
if [ -n "$dwm_pid" ] && [ -f "/proc/$dwm_pid/environ" ]; then
    DISP="$(tr '\0' '\n' < "/proc/$dwm_pid/environ" 2>/dev/null | grep '^DISPLAY=' | cut -d= -f2- | head -1)"
    XAUTH="$(tr '\0' '\n' < "/proc/$dwm_pid/environ" 2>/dev/null | grep '^XAUTHORITY=' | cut -d= -f2- | head -1)"
fi
[ -z "$DISP" ] && DISP=":0"
if [ -z "$XAUTH" ]; then
    user_home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)"
    [ -z "$user_home" ] && user_home="/home/$user"
    [ -f "$user_home/.Xauthority" ] && XAUTH="$user_home/.Xauthority"
fi

if [ "$TEST" = "1" ]; then
    echo "TEST: would run: slock as $user on DISPLAY=$DISP XAUTHORITY=${XAUTH:-<unset>}"
    exit 0
fi

log "locking as $user on $DISP (handing to --child)"
if command -v runuser >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec runuser -u "$user" -- env DISPLAY="$DISP" ${XAUTH:+XAUTHORITY="$XAUTH"} /usr/local/bin/screen-lock --child
elif command -v sudo >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec sudo -u "$user" env DISPLAY="$DISP" ${XAUTH:+XAUTHORITY="$XAUTH"} /usr/local/bin/screen-lock --child
else
    exec su -s /bin/sh "$user" -c "DISPLAY='$DISP' ${XAUTH:+XAUTHORITY='$XAUTH'} exec /usr/local/bin/screen-lock --child"
fi
